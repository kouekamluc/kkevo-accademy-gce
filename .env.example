# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (required outside quick local tests)
DATABASE_URL=postgres://gce_user:your-password@localhost:5432/gce_academy
# Email for password reset (outside DEBUG). In DEBUG emails print to the console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=GCE Learning Academy <no-reply@example.com>
# Shared cache for login rate limiting when running several workers
# CACHE_URL=dbcache://django_cache
# Number of proxies in front of the app (for the client IP used in rate limiting)
# DJANGO_TRUSTED_PROXY_COUNT=1
