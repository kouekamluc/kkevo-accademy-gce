{
  "name": "gce-learning-academy",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/app.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static/src/app.css -o ./static/css/app.css --watch",
    "vendor": "node scripts/copy-vendor.js",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/stix-two-text": "^5.3.0",
    "alpinejs": "3.14.9",
    "flowbite": "2.5.2",
    "htmx.org": "2.0.4",
    "katex": "^0.16.11",
    "tailwindcss": "3.4.17"
  }
}
